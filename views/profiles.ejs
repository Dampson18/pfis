<%- include('partials/header') %>

<div class="page-header">
    <div class="container">
      <div>
        <div class="breadcrumb">PFIS &rsaquo; <span>User Profiles</span></div>
        <h2>Registered User Profiles</h2>
        <p>Behavioural baselines and segmentation profiles for monitored users</p>
      </div>
    </div>
  </div>
  <div class="container page-content">
    <div class="grid-2 mb-20" id="profileCards"></div>

    <div class="card">
      <div class="card-header"><h3>Behavioural Segmentation Framework</h3></div>
      <div class="card-body">
        <p style="margin-bottom:16px;color:var(--gov-muted);font-size:13px;">PFIS groups users into broad demographic categories, then further subdivides by observed behavioural patterns. This layered model enables precise anomaly detection with minimal false positives.</p>
        <div class="grid-3">
          <div style="border:1px solid var(--gov-border);padding:14px;border-top:3px solid var(--gov-navy);">
            <div style="font-weight:700;color:var(--gov-navy);margin-bottom:10px;font-family:var(--font-serif);font-size:16px;">Students</div>
            <div class="text-small text-muted">Age 18–25 · Low–medium income</div>
            <hr class="divider">
            <div style="font-size:12px;color:var(--gov-text);">· Savers<br>· Freelancers<br>· Frequent Senders/Receivers<br>· Bursary Recipients</div>
          </div>
          <div style="border:1px solid var(--gov-border);padding:14px;border-top:3px solid var(--gh-gold);">
            <div style="font-weight:700;color:var(--gov-navy);margin-bottom:10px;font-family:var(--font-serif);font-size:16px;">Workers</div>
            <div class="text-small text-muted">Age 25–55 · Regular employment</div>
            <hr class="divider">
            <div style="font-size:12px;color:var(--gov-text);">· Bill Payers<br>· Remittance Senders<br>· Salary Recipients<br>· Commuters</div>
          </div>
          <div style="border:1px solid var(--gov-border);padding:14px;border-top:3px solid var(--gh-red);">
            <div style="font-weight:700;color:var(--gov-navy);margin-bottom:10px;font-family:var(--font-serif);font-size:16px;">Merchants</div>
            <div class="text-small text-muted">Traders &amp; business owners</div>
            <hr class="divider">
            <div style="font-size:12px;color:var(--gov-text);">· Bulk Receivers<br>· Frequent Traders<br>· Wholesale Buyers<br>· Market Vendors</div>
          </div>
        </div>
      </div>
    </div>
  </div>

