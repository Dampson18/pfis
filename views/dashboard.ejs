<%- include('partials/header') %>

<div class="page-header">
    <div class="container">
      <div>
        <div class="breadcrumb">PFIS &rsaquo; <span>Dashboard</span></div>
        <h2>Command Dashboard</h2>
        <p>Real-time command view for Ghana's mobile money fraud operations</p>
      </div>
      <div style="text-align:right;font-size:12px;color:#7a92b0;" id="dashTime"></div>
    </div>
  </div>
  <div class="container page-content">
    
    <!-- Engine offline notice -->
    <div class="notice" id="engineNotice">
      ⚠ <strong>Demo feed paused:</strong> Activate the engine to preview live operator events and risk decisions.
    </div>

    <!-- Telecom Fraud & Fake SMS Scam Analyzer Section -->
    <div class="card mb-20" style="border-top: 3px solid var(--gov-navy);">
      <div class="card-header" style="background:#f8fafc;">
        <h3>📱 Verify a Mobile Money Alert</h3>
        <span class="badge badge-navy">Ghana Telco Protection (MTN / Telecel / AT)</span>
      </div>
      <div class="card-body">
        <p style="font-size:13px;color:var(--gov-muted);margin-bottom:14px;">
          Check a customer complaint or contact-centre escalation against sender identity, transaction reference, message structure and the PFIS risk model before approving a reversal.
        </p>
        <div class="dashboard-analyzer" style="display:grid;grid-template-columns: 1fr 1fr;gap:16px;">
          <div>
            <div class="form-group">
              <label class="form-label">Telecom Network</label>
              <select class="form-control" id="smsTelcoSelect">
                <option value="MTN">MTN Mobile Money (MoMo)</option>
                <option value="TELECEL">Telecel Cash</option>
                <option value="AT">AT Money (AirtelTigo Money)</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Sender ID or Phone Number</label>
              <input type="text" class="form-control" id="smsSenderInput" placeholder="e.g., MobileMoney, 0244000111, TelecelCash, or ATMoney" value="0244987654">
            </div>
            <div class="form-group">
              <label class="form-label">SMS Message Content</label>
              <textarea class="form-control" id="smsTextInput" rows="4" placeholder="Paste the SMS text here... e.g. Payment received for GHS 850.00 from Kwame Mensah. Txn ID: TXN987123. Current balance: GHS 1250.00"></textarea>
            </div>
            <div class="btn-group">
              <button class="btn btn-primary" onclick="checkSmsScam()">🔍 Run Alert Verification</button>
              <button class="btn btn-outline" onclick="loadSampleScamSms()">Load Sample Scam SMS</button>
              <button class="btn btn-outline" onclick="loadSampleLegitSms()">Load Sample Authentic SMS</button>
            </div>
          </div>

          <div>
            <div id="smsResultBox" style="background:var(--gov-silver);border:1px solid var(--gov-border);padding:16px;border-radius:2px;height:100%;">
              <div style="font-weight:700;color:var(--gov-navy);margin-bottom:8px;font-size:14px;">Analysis Results & Risk Breakdown</div>
              <div class="text-muted text-small" id="smsResultPlaceholder">Enter an SMS message on the left and click <strong>"Analyze SMS Risk Factor"</strong> to run real-time verification against Ghana telecom transaction ledgers.</div>
              <div id="smsResultDetails" style="display:none;"></div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- STATS -->
    <div class="stats-grid">
      <div class="stat-card"><div class="label">Events Evaluated</div><div class="value" id="st-total">0</div><div class="sub">Current demo feed</div></div>
      <div class="stat-card green"><div class="label">Safe Transactions</div><div class="value" id="st-safe">0</div><div class="sub">Score 0–40</div></div>
      <div class="stat-card amber"><div class="label">Moderate Risk</div><div class="value" id="st-mod">0</div><div class="sub">Score 41–70, monitoring</div></div>
      <div class="stat-card red"><div class="label">High Risk / Blocked</div><div class="value" id="st-high">0</div><div class="sub">Score 71–100, flagged</div></div>
      <div class="stat-card gold"><div class="label">Value Held for Review</div><div class="value" id="st-saved" style="font-size:20px;">₵0.00</div><div class="sub">Blocked or cancelled</div></div>
      <div class="stat-card"><div class="label">Detection Rate</div><div class="value" id="st-rate">—</div><div class="sub">High risk caught</div></div>
    </div>

    <div class="grid-2">
      <!-- Risk Distribution -->
      <div class="card">
        <div class="card-header"><h3>Risk Distribution</h3><span class="card-meta" id="distMeta">No data</span></div>
        <div class="card-body">
          <div id="distBars" style="display:flex;flex-direction:column;gap:10px;">
            <div class="text-muted text-small">Activate the engine to see live distribution.</div>
          </div>
        </div>
      </div>

      <!-- Score Trend -->
      <div class="card">
        <div class="card-header"><h3>Risk Score Trend</h3><span class="card-meta">Last 20 transactions</span></div>
        <div class="card-body">
          <svg id="trendSvg" width="100%" height="90" style="display:block;">
            <text x="50%" y="50%" text-anchor="middle" fill="#CBD5E0" font-size="13" font-family="Source Sans 3">No data — engine offline</text>
          </svg>
        </div>
      </div>
    </div>

    <!-- Recent High-Risk Transactions -->
    <div class="card">
      <div class="card-header">
        <h3>Recent High-Risk Telecom Transactions</h3>
        <button class="btn btn-outline btn-sm" onclick="window.location='/transactions'">View All →</button>
      </div>
      <div class="card-body" style="padding:0;">
        <table class="gov-table" id="dashHighTable">
          <thead><tr><th>Ref No.</th><th>Telco Network</th><th>Customer</th><th>Amount</th><th>Risk Score</th><th>Fraud Category</th><th>Time</th><th>Status</th><th>Action</th></tr></thead>
          <tbody id="dashHighBody"><tr><td colspan="9" style="text-align:center;color:var(--gov-muted);padding:28px;">No high-risk transactions detected.</td></tr></tbody>
        </table>
      </div>
    </div>

    <!-- Shared Telco Scammer Blacklist & Threat Intelligence Widget -->
    <div class="card mb-20">
      <div class="card-header" style="background:#f8fafc;">
        <h3>🚨 Shared Telco Threat Intelligence</h3>
        <span class="badge badge-high">Cross-Operator Protection</span>
      </div>
      <div class="card-body">
        <div style="display:grid;grid-template-columns: 2fr 1fr;gap:16px;">
          <div>
            <div style="display:flex;gap:8px;margin-bottom:12px;">
              <input type="text" class="form-control" id="blacklistSearchInput" placeholder="Search phone number (e.g. 0244012999) or agent ID...">
              <button class="btn btn-primary" onclick="searchBlacklist()">Search Threat DB</button>
            </div>
            <div style="max-height:180px;overflow-y:auto;">
              <table class="gov-table">
                <thead><tr><th>Target Value</th><th>Type</th><th>Reason / Vector</th><th>Operator</th><th>Reports</th><th>Risk</th></tr></thead>
                <tbody id="blacklistTableBody">
                  <tr><td colspan="6" style="text-align:center;padding:16px;color:var(--gov-muted);">Loading threat intelligence records...</td></tr>
                </tbody>
              </table>
            </div>
          </div>

          <div style="background:var(--gov-silver);padding:14px;border:1px solid var(--gov-border);border-radius:2px;">
            <div style="font-weight:700;color:var(--gov-navy);font-size:13px;margin-bottom:8px;">Report Fraudulent Number / Agent</div>
            <div class="form-group" style="margin-bottom:8px;">
              <label class="form-label" style="font-size:10px;">Phone Number / Agent Code</label>
              <input class="form-control" id="reportValue" placeholder="e.g. 0503991200 or AG-9900" style="padding:6px 8px;font-size:12px;">
            </div>
            <div class="form-group" style="margin-bottom:8px;">
              <label class="form-label" style="font-size:10px;">Scam Reason</label>
              <select class="form-control" id="reportReason" style="padding:6px 8px;font-size:12px;">
                <option>Fake MoMo Reversal SMS Scam</option>
                <option>Unsolicited Agent Cashout Prompt Exploit</option>
                <option>Fake Loan / Promo Scam</option>
                <option>SIM Swap Takeover Attempt</option>
              </select>
            </div>
            <button class="btn btn-danger btn-sm" style="width:100%;" onclick="reportScammer()">+ Share with Operator Network</button>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom row -->
    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3>Transactions by User Type</h3></div>
        <div class="card-body" id="userTypeChart">
          <div class="text-muted text-small">Engine offline.</div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h3>System Activity Log</h3></div>
        <div class="card-body" style="padding:0;max-height:220px;overflow-y:auto;">
          <table class="gov-table">
            <tbody id="activityLog">
              <tr><td style="color:var(--gov-muted);font-size:12px;">System initialised. Awaiting engine activation.</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

<!-- TRANSACTION DETAIL MODAL -->
<div class="modal-overlay" id="txnModal">
  <div class="modal">
    <div class="modal-header">
      <h3 id="modalTitle">Transaction Detail</h3>
      <button class="modal-close" onclick="closeModal('txnModal')">×</button>
    </div>
    <div class="modal-body" id="modalBody"></div>
    <div class="modal-footer" id="modalFooter">
      <button class="btn btn-outline" onclick="closeModal('txnModal')">Close</button>
    </div>
  </div>
</div>

<%- include('partials/footer') %>