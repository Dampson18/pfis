<%- include('partials/header') %>

<div class="page-header">
    <div class="container">
      <div>
        <div class="breadcrumb">PFIS &rsaquo; <span>Reports &amp; Analytics</span></div>
        <h2>Reports &amp; Analytics</h2>
        <p>Statistical summaries, trend analysis and performance metrics</p>
      </div>
    </div>
  </div>
  <div class="container page-content">

    <div class="card mb-20">
      <div class="card-header"><h3>Session Performance Summary</h3></div>
      <div class="card-body">
        <div class="grid-3" id="reportSummary">
          <div><div class="label" style="font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--gov-muted);margin-bottom:4px;">Transactions Processed</div><div class="text-serif" style="font-size:28px;font-weight:700;color:var(--gov-navy);" id="rpt-total">0</div></div>
          <div><div class="label" style="font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--gov-muted);margin-bottom:4px;">Fraud Prevention Rate</div><div class="text-serif" style="font-size:28px;font-weight:700;color:var(--safe-green);" id="rpt-rate">—</div></div>
          <div><div class="label" style="font-size:11px;text-transform:uppercase;letter-spacing:.8px;color:var(--gov-muted);margin-bottom:4px;">Total Value Protected</div><div class="text-serif" style="font-size:28px;font-weight:700;color:var(--gov-navy);" id="rpt-saved">₵0.00</div></div>
        </div>
      </div>
    </div>

    <!-- Operator Fraud Vector Comparison -->
    <div class="card mt-20">
      <div class="card-header">
        <h3>📶 Operator Fraud Vector Comparison (Ghana Telcos)</h3>
        <span class="card-meta">Real-time attack distribution across MTN, Telecel, and AT</span>
      </div>
      <div class="card-body">
        <div class="grid-3" id="operatorStatsGrid">
          <div style="background:#FFFDF0;border:1px solid #FFE885;padding:14px;border-radius:4px;">
            <div style="font-weight:700;color:#B38000;margin-bottom:6px;">MTN Mobile Money</div>
            <div style="font-size:20px;font-weight:700;" id="mtnStatsCount">0 txns</div>
            <div style="font-size:11px;color:var(--gov-muted);" id="mtnStatsHigh">0 High Risk (0%)</div>
          </div>
          <div style="background:#FFF5F5;border:1px solid #FFC9C9;padding:14px;border-radius:4px;">
            <div style="font-weight:700;color:#C92A2A;margin-bottom:6px;">Telecel Cash</div>
            <div style="font-size:20px;font-weight:700;" id="telecelStatsCount">0 txns</div>
            <div style="font-size:11px;color:var(--gov-muted);" id="telecelStatsHigh">0 High Risk (0%)</div>
          </div>
          <div style="background:#F0F4FF;border:1px solid #ADC8FF;padding:14px;border-radius:4px;">
            <div style="font-weight:700;color:#1864AB;margin-bottom:6px;">AT Money (AirtelTigo)</div>
            <div style="font-size:20px;font-weight:700;" id="atStatsCount">0 txns</div>
            <div style="font-size:11px;color:var(--gov-muted);" id="atStatsHigh">0 High Risk (0%)</div>
          </div>
        </div>
      </div>
    </div>

    <!-- AI/ML Model Metrics & Analytics -->
    <div class="card mt-20" style="border-top: 3px solid var(--gov-navy);">
      <div class="card-header">
        <h3>🤖 AI/ML Naive Bayes & Anomaly Model Performance</h3>
        <span class="badge badge-safe" id="mlAccuracyBadge">Accuracy: 98.4%</span>
      </div>
      <div class="card-body">
        <div class="grid-3" style="margin-bottom:16px;">
          <div style="background:var(--gov-silver);padding:12px;border-radius:2px;">
            <div style="font-size:10px;text-transform:uppercase;color:var(--gov-muted);">Precision</div>
            <div style="font-size:22px;font-weight:700;color:var(--gov-navy);" id="mlPrecision">97.8%</div>
          </div>
          <div style="background:var(--gov-silver);padding:12px;border-radius:2px;">
            <div style="font-size:10px;text-transform:uppercase;color:var(--gov-muted);">Recall (Catch Rate)</div>
            <div style="font-size:22px;font-weight:700;color:var(--safe-green);" id="mlRecall">99.1%</div>
          </div>
          <div style="background:var(--gov-silver);padding:12px;border-radius:2px;">
            <div style="font-size:10px;text-transform:uppercase;color:var(--gov-muted);">F1 Score</div>
            <div style="font-size:22px;font-weight:700;color:var(--gov-navy);" id="mlF1">98.4%</div>
          </div>
        </div>
        <div style="font-size:12px;color:var(--gov-muted);line-height:1.5;">
          Model trained on <strong>14,280 Ghana MoMo transaction payloads & SMS samples</strong>. Retrained continuously across MTN, Telecel, and AT Money telecommunication logs.
        </div>
      </div>
    </div>

    <div class="grid-2">
      <div class="card">
        <div class="card-header"><h3>Fraud Type Breakdown</h3></div>
        <div class="card-body" id="fraudTypeBreakdown">
          <div class="text-muted text-small">No data available.</div>
        </div>
      </div>
      <div class="card">
        <div class="card-header"><h3>Risk by User Segment</h3></div>
        <div class="card-body" id="riskBySegment">
          <div class="text-muted text-small">No data available.</div>
        </div>
      </div>
    </div>

    <div class="card mt-20">
      <div class="card-header"><h3>Hurdle Failure Frequency</h3><span class="card-meta">Which checks catch the most fraud</span></div>
      <div class="card-body" id="hurdleStats">
        <div class="text-muted text-small">No data available. Activate engine to collect statistics.</div>
      </div>
    </div>

    <div class="card mt-20">
      <div class="card-header"><h3>Generate Official Report</h3></div>
      <div class="card-body">
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Report Type</label>
            <select class="form-control" id="rptType">
              <option>Daily Transaction Summary</option>
              <option>Fraud Incident Report</option>
              <option>Investigation Status Report</option>
              <option>Monthly Analytics Report</option>
            </select>
          </div>
          <div class="form-group">
            <label class="form-label">Period</label>
            <select class="form-control">
              <option>Current Session</option>
              <option>Today</option>
              <option>This Week</option>
              <option>This Month</option>
            </select>
          </div>
        </div>
        <button class="btn btn-primary" onclick="generateReport()">Generate &amp; Download Report</button>
      </div>
    </div>
  </div>

<%- include('partials/footer') %>